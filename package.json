{
  "name": "st-joseph-curriculum-portal",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "docusaurus": "docusaurus",
    "start": "docusaurus start",
    "obfuscate": "javascript-obfuscator static/js/webrtc-agent.js --output static/js/webrtc-agent.js --compact true --control-flow-flattening true --dead-code-injection true",
    "ingest:oak": "npx tsx scripts/ingest-oak.ts",
    "ingest:bulk": "npx tsx scripts/ingest-bulk-oak.ts",
    "build": "npm run ingest:oak && docusaurus build",
    "mine:watch": "ts-node --esm scripts/watchSubstrates.ts",
    "dev": "concurrently \"npm run mine:watch\" \"docusaurus start\"",
    "deploy": "docusaurus deploy"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "3.10.2",
    "@docusaurus/tsconfig": "3.10.2",
    "@docusaurus/types": "3.10.2",
    "chokidar": "^5.0.0",
    "process": "^0.11.10",
    "typescript": "~5.4.0"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 3 chrome version",
      "last 3 firefox version",
      "last 5 safari version"
    ]
  },
  "engines": {
    "node": ">=20.0"
  },
  "dependencies": {
    "@docusaurus/core": "^3.10.2",
    "@docusaurus/plugin-pwa": "^3.10.2",
    "@docusaurus/preset-classic": "^3.10.2",
    "@mlc-ai/web-llm": "^0.2.84",
    "@school-ai/edge-runtime": "file:packages/edge-runtime",
    "edge-runtime": "^4.0.1"
  }
}
