(:scene :id "phet-ohms-law" :title "PhET Invariant: Ohm's Law (V = I × R)" :stage "KS3/KS4 PHYSICS" :duration 12.0
  (:vars (
    (:var :name "voltage" :val 12.0 :min 1.5 :max 24.0 :step 0.5 :label "Battery Voltage (V)")
    (:var :name "resistance" :val 4.0 :min 1.0 :max 20.0 :step 0.5 :label "Circuit Resistance (Ω)")
    (:var :name "switchClosed" :val true :label "Knife Switch State")
  ))
  (:inputs (
    (:slider :var "voltage" :label "Voltage (V)" :min 1.5 :max 24.0 :step 0.5)
    (:slider :var "resistance" :label "Resistance (Ω)" :min 1.0 :max 20.0 :step 0.5)
  ))
  (:computed (
    (:name "current" :expr "(vars.switchClosed !== false ? vars.voltage / vars.resistance : 0).toFixed(2)")
    (:name "power" :expr "(vars.switchClosed !== false ? (vars.voltage * vars.voltage) / vars.resistance : 0).toFixed(1)")
  ))
  (:static (
    (:element :target "#battery-unit" :cache true)
    (:element :target "#resistor-unit" :cache true)
  ))
  (:actors (
    (:actor :target "#active-wire" :kinematic true :will-change true)
    (:actor :target "#current-readout" :kinematic true)
    (:actor :target "#bulb-halo" :kinematic true :will-change true)
  ))
  (:gestures (
    (:interactive :target "#circuit-switch" :action "toggle-switch")
    (:draggable :target "#phet-v-knob" :axis "x" :min 14 :max 316 :var "voltage")
    (:draggable :target "#phet-r-knob" :axis "x" :min 14 :max 316 :var "resistance")
  ))
  (:subtitles (
    (:start 0.00 :end 3.50 :en "Ohm's Law governs electrical circuits: current is proportional to voltage and inversely proportional to resistance." :es "La ley de Ohm rige los circuitos: la corriente es proporcional al voltaje e inversamente a la resistencia.")
    (:start 3.50 :end 7.50 :en "Drag the voltage or resistance sliders, click stepper buttons, or toggle the switch to see live physics." :es "Arrastra los controles de voltaje o resistencia, pulsa los botones o abre el interruptor para ver la física en vivo.")
    (:start 7.50 :end 12.00 :en "Increasing resistance restricts electron velocity, while opening the knife switch halts current entirely." :es "Aumentar la resistencia restringe la velocidad de los electrones, mientras que abrir el interruptor detiene el flujo.")
  ))
  (:keyframes (
    (:t 0.00 :title "1. Equilibrium Current" :rule "V = 12.0V, R = 4.0Ω -> I = 3.00 Amperes")
    (:t 0.35 :title "2. Voltage Surge" :rule "Drag voltage up: Higher potential pushes more coulombs per second")
    (:t 0.70 :title "3. Resistance Imbalance" :rule "Drag resistance up: Internal lattice collisions reduce current")
    (:t 1.00 :title "4. Conservation Verified" :rule "P = V × I power dissipation constant maintained")
  ))
  (:interactive (
    (:checkpoint :t 0.35
      :prompt "According to Ohm's Law (I = V / R), if you double the battery voltage from 12V to 24V while keeping resistance at 4Ω, what happens?"
      :options (
        "Current doubles from 3.0A to 6.0A and the lightbulb shines brightly"
        "Current drops in half to 1.5A"
        "Resistance increases automatically to 8Ω"
      )
      :answer 0
      :explanation "Current is directly proportional to voltage: 24V / 4Ω = 6.00 Amperes! Doubling voltage doubles charge flow.")
    (:checkpoint :t 0.75
      :prompt "What happens when you click the knife switch to open the circuit?"
      :options (
        "Current immediately drops to 0.00A because the conductive loop is broken"
        "Current continues flowing across the air gap"
        "The battery voltage drops to 0V"
      )
      :answer 0
      :explanation "An unbroken conducting loop is required for current to flow. Opening the knife switch creates an open circuit with zero current.")
  ))
  (:bindings (
    (:target "#current-readout" :attr "textContent" :expr "vars.switchClosed !== false ? 'I = ' + computed.current + ' Amperes' : 'I = 0.00 A (Open Circuit)'")
    (:target "#power-readout" :attr "textContent" :expr "vars.switchClosed !== false ? 'Power: ' + computed.power + ' W • Closed Circuit' : 'Power: 0.0 W • Open Circuit (No Flow)'")
    (:target "#txt-voltage" :attr "textContent" :expr "Number(vars.voltage).toFixed(1) + ' V'")
    (:target "#ctrl-v-val" :attr "textContent" :expr "Number(vars.voltage).toFixed(1) + ' V'")
    (:target "#txt-resistance" :attr "textContent" :expr "Number(vars.resistance).toFixed(1) + ' Ω'")
    (:target "#ctrl-r-val" :attr "textContent" :expr "Number(vars.resistance).toFixed(1) + ' Ω'")
    (:target "#bulb-halo" :attr "opacity" :expr "vars.switchClosed !== false ? Math.min(1.0, 0.2 + (computed.power / 50)) : 0.05")
    (:target "#bulb-halo" :attr "r" :expr "vars.switchClosed !== false ? String(36 + Math.min(36, computed.power * 0.7)) : '20'")
    (:target "#active-wire" :attr "stroke-dashoffset" :expr "vars.switchClosed !== false ? String(t * -380 * (computed.current / 3.0)) : '0'")
  ))
)
