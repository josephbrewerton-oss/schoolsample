(:scene :id "fish-tank" :title "Aquarium Stress Benchmark: Vector Point & FPS Limiter" :stage "BENCHMARK & STRESS LAB" :duration 12.0
  (:vars (
    (:var :name "schoolSize" :val 12 :min 1 :max 30 :step 1 :label "Active Fish Boids")
    (:var :name "kelpTurbulence" :val 1.0 :min 0.2 :max 3.0 :step 0.2 :label "Water Flow Velocity")
  ))
  (:inputs (
    (:slider :var "schoolSize" :label "Boid Density (Point Load)" :min 1 :max 30 :step 1)
    (:slider :var "kelpTurbulence" :label "Hydrodynamic Flow" :min 0.2 :max 3.0 :step 0.2)
  ))
  (:computed (
    (:name "vectorVertexCount" :expr "vars.schoolSize * 24 + 120")
    (:name "renderBudgetMs" :expr "(16.66).toFixed(2)")
  ))
  (:gestures (
    (:draggable :target "#kelp-1" :axis "x" :min 30 :max 160)
  ))
  (:subtitles (
    (:start 0.00 :end 0.30 :en "Stress testing the SVG vector rendering pipeline with animated multi-point fish boids." :es "Prueba de esfuerzo del pipeline SVG con peces animados de múltiples vértices.")
    (:start 0.30 :end 0.70 :en "Watch the live FPS and frame time budget as active points and vector DOM nodes increase." :es "Observa los FPS y el tiempo de renderizado a medida que aumentan los vértices.")
    (:start 0.70 :end 1.00 :en "The computed safe ceiling determines the ideal point boundary for this hardware." :es "El límite seguro calculado establece la frontera ideal de puntos para este dispositivo.")
  ))
  (:keyframes (
    (:t 0.00 :title "Baseline Aquarium" :rule "Calibrating baseline frame rendering at 60 FPS")
    (:t 0.33 :title "Schooling Dynamics" :rule "Evaluating multi-point fin undulation and collision vectors")
    (:t 0.66 :title "Vertex Stress Test" :rule "Measuring composite reflow limits across hardware threads")
    (:t 1.00 :title "Hardware Safe Limit" :rule "Optimal ceiling calculated and stored in local configuration")
  ))
  (:interactive (
    (:checkpoint :t 0.50
      :prompt "Why does an SVG player have a practical limit on the number of animated points and nodes?"
      :options (
        "Because browsers evaluate the DOM tree and re-rasterize vector bezier curves on each frame"
        "Because SVG files expire after 60 seconds of playback"
        "Because vector math only works on computers with a dedicated liquid cooler"
      )
      :answer 0
      :explanation "Unlike flat pixel video, SVG vector rendering recalculates geometry and patches DOM element attributes every 16.6ms. Finding the point limit allows us to govern scenes safely for smooth 60 FPS on any Chromebook, mobile device, or PC."
    )
  ))
  (:bindings (
    (:target "#kelp-1" :attr "d" :expr "'M 60,450 Q ' + (80 + Math.sin(t * Math.PI * 4 * (vars.kelpTurbulence || 1)) * 14) + ',340 50,240 T ' + (70 + Math.cos(t * Math.PI * 4 * (vars.kelpTurbulence || 1)) * 12) + ',120 T 40,30'")
    (:target "#kelp-2" :attr "d" :expr "'M 90,460 Q ' + (120 + Math.cos(t * Math.PI * 3.5 * (vars.kelpTurbulence || 1)) * 16) + ',360 85,260 T ' + (110 + Math.sin(t * Math.PI * 3.5 * (vars.kelpTurbulence || 1)) * 14) + ',150 T 80,50'")
    (:target "#kelp-3" :attr "d" :expr "'M 720,450 Q ' + (700 + Math.sin(t * Math.PI * 3.8 * (vars.kelpTurbulence || 1)) * 16) + ',340 735,240 T ' + (710 + Math.cos(t * Math.PI * 3.8 * (vars.kelpTurbulence || 1)) * 14) + ',130 T 740,35'")
    (:target "#kelp-4" :attr "d" :expr "'M 750,460 Q ' + (730 + Math.cos(t * Math.PI * 4.2 * (vars.kelpTurbulence || 1)) * 12) + ',370 760,270 T ' + (735 + Math.sin(t * Math.PI * 4.2 * (vars.kelpTurbulence || 1)) * 10) + ',160 T 765,60'")
    (:target "#fish-1" :attr "transform" :expr "'translate(' + (280 + Math.sin(t * Math.PI * 2 * (vars.kelpTurbulence || 1)) * 140) + ', ' + (250 + Math.cos(t * Math.PI * 4 * (vars.kelpTurbulence || 1)) * 24) + ') scale(' + (Math.cos(t * Math.PI * 2 * (vars.kelpTurbulence || 1)) >= 0 ? 1 : -1) + ', 1)'")
    (:target "#fish-2" :attr "transform" :expr "'translate(' + (450 + Math.cos(t * Math.PI * 2 * 0.85 * (vars.kelpTurbulence || 1)) * 160) + ', ' + (190 + Math.sin(t * Math.PI * 4 * 0.85 * (vars.kelpTurbulence || 1)) * 28) + ') scale(' + (-Math.sin(t * Math.PI * 2 * 0.85 * (vars.kelpTurbulence || 1)) >= 0 ? 1 : -1) + ', 1)'")
    (:target "#fish-3" :attr "transform" :expr "'translate(' + (560 + Math.sin(t * Math.PI * 2 * 0.9 * (vars.kelpTurbulence || 1) + 1.2) * 150) + ', ' + (300 + Math.cos(t * Math.PI * 4 * 0.9 * (vars.kelpTurbulence || 1) + 1.2) * 20) + ') scale(' + (Math.cos(t * Math.PI * 2 * 0.9 * (vars.kelpTurbulence || 1) + 1.2) >= 0 ? 1 : -1) + ', 1)'")
    (:target "#fish-4" :attr "transform" :expr "'translate(' + (220 + Math.sin(t * Math.PI * 2 * 1.2 * (vars.kelpTurbulence || 1) + 2.0) * 120) + ', ' + (330 + Math.sin(t * Math.PI * 6 * 1.2 * (vars.kelpTurbulence || 1)) * 16) + ') scale(' + (Math.cos(t * Math.PI * 2 * 1.2 * (vars.kelpTurbulence || 1) + 2.0) >= 0 ? 1 : -1) + ', 1)'")
    (:target "#fish-5" :attr "transform" :expr "'translate(' + (380 + Math.cos(t * Math.PI * 2 * 0.75 * (vars.kelpTurbulence || 1) + 0.6) * 170) + ', ' + (145 + Math.sin(t * Math.PI * 3 * 0.75 * (vars.kelpTurbulence || 1)) * 22) + ') scale(' + (-Math.sin(t * Math.PI * 2 * 0.75 * (vars.kelpTurbulence || 1) + 0.6) >= 0 ? 1 : -1) + ', 1)'")
    (:target "#fish-6" :attr "transform" :expr "'translate(' + (510 + Math.sin(t * Math.PI * 2 * 1.1 * (vars.kelpTurbulence || 1) + 3.1) * 135) + ', ' + (260 + Math.cos(t * Math.PI * 5 * 1.1 * (vars.kelpTurbulence || 1)) * 18) + ') scale(' + (Math.cos(t * Math.PI * 2 * 1.1 * (vars.kelpTurbulence || 1) + 3.1) >= 0 ? 1 : -1) + ', 1)'")
    (:target "#fish-7" :attr "transform" :expr "'translate(' + (250 + Math.sin(t * Math.PI * 2 * (vars.kelpTurbulence || 1) - 0.25) * 135) + ', ' + (275 + Math.cos(t * Math.PI * 4 * (vars.kelpTurbulence || 1) - 0.25) * 22) + ') scale(' + (Math.cos(t * Math.PI * 2 * (vars.kelpTurbulence || 1) - 0.25) >= 0 ? 0.9 : -0.9) + ', 0.9)'")
    (:target "#fish-8" :attr "transform" :expr "'translate(' + (160 + Math.cos(t * Math.PI * 2 * 1.3 * (vars.kelpTurbulence || 1) + 1.1) * 110) + ', ' + (220 + Math.sin(t * Math.PI * 4 * 1.3 * (vars.kelpTurbulence || 1)) * 20) + ') scale(' + (-Math.sin(t * Math.PI * 2 * 1.3 * (vars.kelpTurbulence || 1) + 1.1) >= 0 ? 1 : -1) + ', 1)'")
    (:target "#fish-9" :attr "transform" :expr "'translate(' + (630 + Math.sin(t * Math.PI * 2 * 0.85 * (vars.kelpTurbulence || 1) + 2.2) * 125) + ', ' + (185 + Math.cos(t * Math.PI * 4 * 0.85 * (vars.kelpTurbulence || 1)) * 24) + ') scale(' + (Math.cos(t * Math.PI * 2 * 0.85 * (vars.kelpTurbulence || 1) + 2.2) >= 0 ? 1 : -1) + ', 1)'")
    (:target "#fish-10" :attr "transform" :expr "'translate(' + (320 + Math.sin(t * Math.PI * 2 * 1.25 * (vars.kelpTurbulence || 1) + 2.5) * 130) + ', ' + (375 + Math.sin(t * Math.PI * 6 * 1.25 * (vars.kelpTurbulence || 1)) * 15) + ') scale(' + (Math.cos(t * Math.PI * 2 * 1.25 * (vars.kelpTurbulence || 1) + 2.5) >= 0 ? 1 : -1) + ', 1)'")
    (:target "#fish-11" :attr "transform" :expr "'translate(' + (480 + Math.cos(t * Math.PI * 2 * 0.68 * (vars.kelpTurbulence || 1) + 1.9) * 165) + ', ' + (345 + Math.sin(t * Math.PI * 3 * 0.68 * (vars.kelpTurbulence || 1)) * 25) + ') scale(' + (-Math.sin(t * Math.PI * 2 * 0.68 * (vars.kelpTurbulence || 1) + 1.9) >= 0 ? 1 : -1) + ', 1)'")
    (:target "#fish-12" :attr "transform" :expr "'translate(' + (580 + Math.sin(t * Math.PI * 2 * 1.05 * (vars.kelpTurbulence || 1) + 4.1) * 140) + ', ' + (220 + Math.cos(t * Math.PI * 4 * 1.05 * (vars.kelpTurbulence || 1)) * 20) + ') scale(' + (Math.cos(t * Math.PI * 2 * 1.05 * (vars.kelpTurbulence || 1) + 4.1) >= 0 ? 1 : -1) + ', 1)'")
    (:target "#bubble-1" :attr "transform" :expr "'translate(140, ' + (420 - (((t * 1.5) % 1) * 360)) + ')'")
    (:target "#bubble-2" :attr "transform" :expr "'translate(' + (155 + Math.sin(t * Math.PI * 8) * 6) + ', ' + (420 - ((((t * 1.8 + 0.35)) % 1) * 370)) + ')'")
    (:target "#bubble-3" :attr "transform" :expr "'translate(' + (130 + Math.cos(t * Math.PI * 7) * 7) + ', ' + (420 - ((((t * 1.4 + 0.7)) % 1) * 360)) + ')'")
    (:target "#bubble-4" :attr "transform" :expr "'translate(680, ' + (420 - ((((t * 1.6 + 0.2)) % 1) * 380)) + ')'")
    (:target "#bubble-5" :attr "transform" :expr "'translate(' + (695 + Math.sin(t * Math.PI * 9) * 5) + ', ' + (420 - ((((t * 1.9 + 0.55)) % 1) * 370)) + ')'")
    (:target "#bubble-6" :attr "transform" :expr "'translate(' + (670 + Math.cos(t * Math.PI * 8) * 6) + ', ' + (420 - ((((t * 1.3 + 0.85)) % 1) * 380)) + ')'")
    (:target "#hud-fish-count" :attr "textContent" :expr "Math.round(vars.schoolSize || 12) + ' Fish'")
    (:target "#hud-points-count" :attr "textContent" :expr "Math.round((vars.schoolSize || 12) * 24 + 120) + ' pts'")
    (:target "#hud-budget-fill" :attr "width" :expr "Math.min(280, Math.max(20, ((vars.schoolSize || 12) / 30) * 280))")
  ))
)
