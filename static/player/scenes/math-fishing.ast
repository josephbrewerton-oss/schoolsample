(:scene :id "math-fishing" :title "Math Pond: Number Bonds Fishing Game" :stage "KS1/KS2 MATHS" :duration 14.0
  (:vars (
    (:var :name "targetSum" :val 20 :min 5 :max 100 :step 1 :label "Target Bond Goal")
    (:var :name "bobberSpeed" :val 1.0 :min 0.5 :max 3.0 :step 0.25 :label "Reeling Current Pace")
  ))
  (:inputs (
    (:slider :var "targetSum" :label "Number Bond Target" :min 5 :max 100 :step 1)
    (:slider :var "bobberSpeed" :label "Water Current Velocity" :min 0.5 :max 3.0 :step 0.25)
  ))
  (:computed (
    (:name "bondComplement" :expr "vars.targetSum - 4")
  ))
  (:gestures (
    (:draggable :target "#water-wave-1" :axis "x" :min -50 :max 50)
  ))
  (:subtitles (
    (:start 0.00 :end 0.35 :en "Welcome to the Math Pond! Watch how catching fish with numbers builds our number bonds." :es "¡Bienvenidos a la laguna matemática! Mira cómo pescar números construye los vínculos numéricos.")
    (:start 0.35 :end 0.70 :en "We have a 4 on our line. To make 10, we must find and catch a fish with 6!" :es "Tenemos un 4 en la caña. ¡Para formar 10, debemos buscar y pescar un 6!")
    (:start 0.70 :end 1.00 :en "4 plus 6 equals 10! A perfect number bond stored right in our tackle bucket." :es "¡4 más 6 es igual a 10! Un vínculo numérico perfecto guardado en la cubeta.")
  ))
  (:keyframes (
    (:t 0.00 :title "Step 1: Pond Inspection" :rule "Scanning swimming fish numerals and ten-frame dots")
    (:t 0.35 :title "Step 2: First Catch (4)" :rule "Reeling in 4: calculating complement needed to reach target 10")
    (:t 0.70 :title "Step 3: Number Bond Hook (6)" :rule "Matching 4 + 6 = 10 with tactile audio chime")
    (:t 1.00 :title "Step 4: Mastery Victory" :rule "Bonds to 10 and 20 provide the foundation for mental arithmetic")
  ))
  (:interactive (
    (:checkpoint :t 0.55
      :prompt "In a challenge where Target = 20, if your hook currently holds fish 7 and fish 5, what missing value z must you catch to satisfy 7 + 5 + z = 20?"
      :options (
        "z = 8 (since 7 + 5 = 12, and 20 - 12 = 8)"
        "z = 12"
        "z = 6"
        "z = 15"
      )
      :answer 0
      :explanation "Combine known catches first: 7 + 5 = 12. To reach the target sum 20, find the complement: 20 - 12 = 8. This forms the algebraic foundation: x + y + z = T."
    )
  ))
  (:bindings (
    (:target "#water-wave-1" :attr "d" :expr "'M 0,' + (155 + Math.sin(t * Math.PI * 4 * (vars.bobberSpeed || 1)) * 3) + ' Q 100,' + (150 + Math.cos(t * Math.PI * 4 * (vars.bobberSpeed || 1)) * 4) + ' 200,155 T 400,155 T 600,155 T 800,155'")
    (:target "#water-wave-2" :attr "d" :expr "'M 0,' + (165 + Math.cos(t * Math.PI * 3.5 * (vars.bobberSpeed || 1)) * 3) + ' Q 150,' + (160 + Math.sin(t * Math.PI * 3.5 * (vars.bobberSpeed || 1)) * 3) + ' 300,165 T 600,165 T 800,165'")
  ))
)
